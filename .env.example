# Postgres connection string (Supabase: Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/events

# https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_API_KEY=

# https://www.eventbrite.com/platform/api  (private token)
EVENTBRITE_TOKEN=

# Sent with every request so site owners can reach you
USER_AGENT=ChicagoEventsBot/0.1 (+mailto:you@example.com)

CITY=chicago
